BOT_URL=https://your-bot.fly.dev
AGENT_SECRET=your-shared-secret-here
POLL_INTERVAL_MS=5000
SKILL_DIR=/path/to/garden/skill
MCP_GARDEN_PATH=/path/to/mcp-garden/dist/index.js
CHAT_ID=your-telegram-chat-id
LATITUDE=63.84
LONGITUDE=23.13
# Tasks backend: "obsidian" (default) or "bear". Bear requires Bear 2.8+ with bearcli.
TASKS_BACKEND=obsidian
# For Bear backend: title of the tasks note (default "Garden Tasks")
TASKS_BEAR_TITLE=Garden Tasks
# For Bear backend: optional note ID — preferred over title to avoid ambiguity if multiple notes share the title
# TASKS_BEAR_ID=
# For Obsidian backend: full path to the tasks markdown file
TASKS_FILE_PATH=/path/to/Garden Tasks.md
# Path to bearcli binary (default /Applications/Bear.app/Contents/MacOS/bearcli)
# BEARCLI_PATH=
